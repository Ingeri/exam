# PostgreSQL connection used by Prisma. Percent-encode reserved characters in credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Required for API bearer JWTs. Use a cryptographically random value of at least 32 bytes.
AUTH_JWT_SECRET="replace-with-a-random-secret-of-at-least-32-bytes"

# Optional JWT claim checks. If set, issued tokens must contain matching claims.
AUTH_JWT_ISSUER=""
AUTH_JWT_AUDIENCE=""

# Optional separate HMAC secret for exam keys. Must remain stable while stored keys are used.
# If omitted, AUTH_JWT_SECRET is used.
# EXAM_KEY_SECRET="replace-with-a-separate-random-secret-of-at-least-32-bytes"

# Optional public origin for applications that consume this headless API.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Compatibility placeholder only: this repository does not use NextAuth.js.
# NEXTAUTH_SECRET="not-used-here"
# API authentication uses AUTH_JWT_SECRET above.
